*.log
*.out
__pycache__/
.env
.DS_Store
node_modules/
*.pyc
.env.local
client/.env
.claude/

# Data caches and per-laptop artifacts (kept out of git intentionally)
# NOTE: use analysis/data/* (not analysis/data/) so individual files below
# can be re-included — git cannot un-ignore a file inside a fully-ignored dir.
analysis/data/*
# Exception: type_classifications.json is curated, hand-edited work (the
# classification source of truth), not a regenerable cache — keep it tracked.
!analysis/data/type_classifications.json
# Exception: trend_verdict_fixtures.json is the shared parity fixture set for
# trend_analyst.py <-> server/lib/trendAnalyst.js (hand-curated test data,
# not a regenerable cache) — keep it tracked.
!analysis/data/trend_verdict_fixtures.json
# Exception: run manifests are the §10b reproducibility contract's citation
# record (git_commit, corpus hashes, params, results) -- the whole point is
# that they're committed, not gitignored like the caches they hash.
!analysis/data/run_manifests/
!analysis/data/run_manifests/*.json
# Exception: run_state is the resumability record for long multi-session
# sweep prompts (progress.json, cells.jsonl, findings.md per run_id) — must
# survive a killed session, so it's committed like run_manifests.
!analysis/data/run_state/
!analysis/data/run_state/**
.envrc.zsh
cat_output
diff_output

# HAR captures (browser network dumps) — used for one-off debugging, get
# overwritten constantly, not worth tracking in git.
*.har

# Note: client/.env.development and client/.env.production are intentionally
# committed — they hold non-sensitive build-time config (VITE_API_URL toggle
# between localhost in dev and same-origin in prod). Vite needs them at
# build time, including during the Railway deployment build.
client/dist/

# Local brokerage position exports -- account data, never versioned
testing/
