generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticker {
  id          Int          @id @default(autoincrement())
  symbol      String       @unique
  name        String
  type        String       // "A" or "B" — production Type A/B classification; source of truth for live allocator
  capPercent  Float
  status      String       @default("watchlist")  // "watchlist" or "portfolio"
  shortName   String?      // e.g. "Amprius" — short display name
  notes       String?
  createdAt   DateTime     @default(now())
  transcripts Transcript[]
  positions   Position[]

  // Portfolio Analyst Phase 1 — Ticker metadata
  inScope            Boolean   @default(true)   // false for legacy/out-of-scope positions
  activeDriverCount  Int?                        // 1-6+; metadata for UI and future variable-cap work
  typeReviewedAt     DateTime?                   // when user last confirmed/overrode Type A/B classification

  // Maturity (tier) classification — Phase 1 schema, UI in Phase 2c
  // tierOverride: user-set value; null means fall back to mechanical classifier
  // tierMechanical: last computed 3-axis result; stored for disagreement-badge diff
  tierOverride       String?   // "speculative" | "established" | null
  tierMechanical     String?   // "speculative" | "established" — last mechanical result
  tierReviewedAt     DateTime? // when user last confirmed/overrode tier
  tierRationale      String?   // user's reasoning for override

  // Portfolio bucket classification — Phase 2
  // Controls which bucket this ticker appears in on the Portfolio page.
  // null → fall back to smartDefault(assetType, symbol) at display time.
  // Values: "equity" | "etf" | "crypto" | "commodity"
  bucketOverride     String?

  // Domain tags — circle of competence classification(s), per DOMAIN.md
  // [] → unassigned. A ticker may span multiple domains (e.g. Tesla →
  // solar + energy_storage).
  // Values: "solar" | "energy_storage" | "semiconductors" |
  //         "it_software_cloud" | "crypto"
  domains            String[]  @default([])

  ownerConfigs       OwnerTickerConfig[]
  ownerDecisions     OwnerDecision[]
}

// Per-owner cap % override for any held position.
// Falls back to Ticker.capPercent when no row exists for a given owner+ticker pair.
model OwnerTickerConfig {
  id         Int    @id @default(autoincrement())
  owner      String
  tickerId   Int
  capPercent Float?            // owner's target allocation % for this ticker

  ticker     Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@unique([owner, tickerId])
}

model Transcript {
  id        Int        @id @default(autoincrement())
  tickerId  Int
  ticker    Ticker     @relation(fields: [tickerId], references: [id])
  callDate  DateTime
  title     String?
  rawText   String
  createdAt DateTime   @default(now())
  analyses  Analysis[]
}

model Analysis {
  id              Int        @id @default(autoincrement())
  transcriptId    Int
  transcript      Transcript @relation(fields: [transcriptId], references: [id])
  rawOutput       String
  thesisHealth    String
  recommendation  String
  recommendedSize Float?
  createdAt       DateTime   @default(now())

  // Structured score fields (added in add_structured_score_fields migration)
  thesisDelta                      String?
  freshMoneyAllocation             Float?
  stumbleType                      String?
  threatMechanismImpaired          Boolean?
  credibilityDelta                 String?
  activeDriverCount                Int?
  ratchetTranche                   Int?
  blindSpotsTriggered              Json?
  capPercent                       Float?
  mitigationArgumentPresent        Boolean?
  mitigationCapabilityTrackRecord  String?
  typeClassificationRationale      String?   // added in add_type_classification_rationale migration

  // Version stamps (added in add_version_columns migration). Server-controlled —
  // never from client input. Matches server/lib/versions.js constants.
  promptVersion  String?   // e.g. "v6" — matches Version header in EVALUATION_PROMPT.md
  modelVersion   String?   // e.g. "claude-sonnet-4-6" — exact model string sent to Anthropic

  // Trend-layer fields (added in add_trend_fields migration). All computed
  // by analysis/trend_analyst.py and synced via sync_trend_to_db.py.
  // - tier: "speculative" | "established" (3-axis classifier output)
  // - trajectory: "deteriorating" | "softening" | "flattening" | "improving" | "stable" | "unknown"
  // - suggestedOverride: "trim_regardless" | "downgrade_one" | "upgrade_one" | null
  // - finalAction: "Add" | "Hold" | "Trim" | "Exit" — what the trend layer
  //   recommends after applying the matrix to the per-call recommendation
  // - finalConfidence: "confident" | "advisory" | "unknown"
  // - trendRationale: human-readable rationale string from the trend layer
  tier              String?
  trajectory        String?
  suggestedOverride String?
  finalAction       String?
  finalConfidence   String?
  trendRationale    String?

  // Plain-English one-liner summarising the key finding that drove this
  // recommendation. Populated by the model at eval time — shown in the
  // Advisory Feed timeline instead of raw field values.
  summary           String?
}

// ---------------------------------------------------------------------------
// Portfolio Analyst — Phase 2 tables
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Owner profiles — one row per distinct owner; created automatically when a
// new owner value appears in Account, or manually via the Users tab.
// ---------------------------------------------------------------------------
model OwnerProfile {
  owner        String   @id          // matches Account.owner exactly (e.g. "Luis Morales")
  displayName  String?               // optional friendly override (e.g. "Luis")
  enoughNumber Float?                // investment goal / "enough number" in dollars

  // ── Access control ────────────────────────────────────────────────────
  clerkUserId  String?  @unique      // Clerk user_* ID — links a login to this owner
  role         String   @default("user") // "admin" | "user"
  inviteEmail  String?  @unique      // pending invite email — cleared when clerkUserId is auto-linked

  // ── Capital & sizing ──────────────────────────────────────────────────
  minPositionDollar Float?           // smallest position worth holding (default $1,500)
  maxPositions      Int?             // hard cap on ticker count (default 15)
  cashReservePct    Float?           // % of portfolio to keep as dry powder (default 0.05)

  // ── Risk profile ──────────────────────────────────────────────────────
  yearsToGoal    Int?                // drives speculative ceiling formula
  estSpecRatio   Float?              // barbell split 0.0–1.0; 0.60 = 60% established (default)
                                      // sub-split WITHIN the Equities bucket only — see below
  riskTolerance  String?             // "conservative" | "moderate" | "aggressive"

  // ── Top-level allocation targets (0.0–1.0, must sum to 1.0) ────────────
  // Replaces the old bottom-up derivation (summing per-ticker capPercent on
  // whatever ETF/crypto is currently held) with an explicit, user-owned
  // target. Independent of yearsToGoal/riskTolerance by design — Luis,
  // 2026-08-08: "One user might set 90% crypto / 10% everything else;
  // another the inverse. The system does not second-guess this."
  // estSpecRatio above only subdivides equitiesTargetPct into established
  // vs speculative; it no longer influences ETF/crypto/commodity sizing.
  equitiesTargetPct    Float?        // default 0.50
  etfTargetPct         Float?        // default 0.20
  cryptoTargetPct      Float?        // default 0.15
  commoditiesTargetPct Float?        // default 0.15

  // ── Tax & account behavior ────────────────────────────────────────────
  taxSensitivity  String?            // "aggressive" | "moderate" | "conservative"
  accountPurpose  String?            // "growth" | "income" | "preservation"

  // ── Domain & universe ─────────────────────────────────────────────────
  domainsOfInterest Json?            // string[] — subset of defined domain tiers
  benchmarkBaseline String?          // "SPY" | "QQQ" | "TMFC" (default "QQQ")

  // ── Rebalancing behavior ──────────────────────────────────────────────
  specExitSpeed    String?           // "fast" | "normal" | "patient"
  newMoneyBehavior String?           // "highest_conviction" | "distribute"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One Account per named brokerage account. Supports multiple accounts of the
// same type (e.g. two taxable accounts), multiple owners, and margin tracking.
model Account {
  id             Int        @id @default(autoincrement())
  name           String                   // e.g. "Schwab Taxable 1"
  type           String                   // "taxable" | "ira" | "roth" | "custodial"
  owner          String                   // "Luis" | "Sofia" | "Kids"
  managed        Boolean    @default(false) // true = agent-managed, false = manual/reference
  ltcgRate       Float?                   // null → use default 0.15
  stcgRate       Float?                   // null → use default 0.15

  // Cash position — updated on each import or manual reconciliation
  cashBalance    Float?
  cashAsOfDate   DateTime?

  // Margin facility — only present if account has margin enabled
  marginBalance  Float?                   // current debit balance (positive = borrowed)
  marginRate     Float?                   // current annualised interest rate (e.g. 0.0825)
  marginRateAsOf DateTime?               // when current rate took effect
  marginRateLog  Json?                   // append-only [{rate: Float, effectiveDate: String}]
  marginAsOfDate DateTime?               // when margin balance was last updated

  notes          String?
  createdAt      DateTime   @default(now())
  positions      Position[]

  // Fractional share trading — set true for accounts where the brokerage
  // supports fractional share purchases (e.g. Schwab Stock Slices for S&P 500
  // stocks). When false, trim/add routing rounds share counts to whole numbers.
  allowsFractional Boolean  @default(false)

  // Schwab API integration — links this local account to a Schwab Trader
  // API account hash (from /accounts/accountNumbers). Null until matched
  // via the reconciliation flow in /api/schwab/reconcile + /match.
  schwabAccountHash String?  @unique

  // Last time syncAccount() successfully ran for this account — drives the
  // "Synced X ago" indicator in SchwabReconcileModal (replaces the
  // always-blue Sync button). Null until first sync.
  lastSyncedAt      DateTime?

  positionConfig    AccountPositionConfig?

  @@unique([name, owner])
}

// One Position per (ticker × account). A ticker held in both taxable and IRA
// has two Position rows.
model Position {
  id         Int       @id @default(autoincrement())
  tickerId   Int
  ticker     Ticker    @relation(fields: [tickerId], references: [id])
  accountId  Int
  account    Account   @relation(fields: [accountId], references: [id])
  status     String    @default("active")  // "active" | "closed"
  notes      String?
  createdAt  DateTime  @default(now())
  closedAt       DateTime?
  lots           Lot[]

  // Last-known market price — populated by refresh-prices endpoint
  lastPrice      Float?
  lastPriceAsOf  DateTime?
  dayChangePct   Float?    // e.g. 0.012 = +1.2%
  dayChangeDollar Float?   // per share

  @@unique([tickerId, accountId])  // one position per ticker+account
}

// ---------------------------------------------------------------------------
// Schwab API integration — Phase 1 (OAuth scaffolding)
// ---------------------------------------------------------------------------

// Single-row table holding the Schwab OAuth token pair. One Schwab login
// (account-holder level) covers all linked brokerage accounts, so this is
// intentionally a singleton (id: 1) rather than per-OwnerProfile.
//
// access_token  — ~30 min lifetime, used as Bearer token on Trader API calls.
// refresh_token — ~7 day lifetime; Schwab issues a NEW refresh_token on every
//                 refresh and the old one becomes invalid — must be persisted
//                 every time (see schwabAuth.js refreshAccessToken()).
model SchwabToken {
  id           Int      @id @default(autoincrement())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Schwab accounts the user has chosen not to link/manage. Reconciliation
// (getReconciliation in schwabSync.js) excludes these from
// `unmatchedSchwab` so they stop reappearing in the Schwab Sync modal every
// time it opens. Surfaced separately as `ignoredSchwab` for an "un-ignore"
// toggle in the UI.
model IgnoredSchwabAccount {
  id                Int      @id @default(autoincrement())
  schwabAccountHash String   @unique
  createdAt         DateTime @default(now())
}

// Cached output of the moves engine — one row per owner.
// Rebuilt whenever prices or positions change (sync, refresh-prices).
// GET /api/moves/:owner serves this directly; first miss computes it.
model MovesCache {
  owner       String   @id  // "Luis" | "Sofia" | etc.
  payload     Json         // full moves API response
  computedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Per-account position target overrides — created when a user accepts a
// too_few_positions or over_concentrated_account warning. Suppresses re-warning
// and feeds the Tier 2 per-account model weights engine (Task #21).
model AccountPositionConfig {
  id           Int     @id @default(autoincrement())
  accountId    Int     @unique
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  minPositions Int?    // accepted target N — floor for per-account weight formula
  maxPositions Int?    // ceiling M override (null = use profile default)
  updatedAt    DateTime @updatedAt
}

// Owner decisions on move-card recommendations — one row per decision event.
// A single move may be re-decided (e.g. declined, then accepted later) — each
// attempt produces a new row; the latest per (owner, tickerId, moveType) wins.
model OwnerDecision {
  id             Int      @id @default(autoincrement())
  owner          String
  tickerId       Int
  ticker         Ticker   @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  moveType       String   // EXIT | TRIM_CAP | TRIM_RATCHET | TRIM_MODEL | ADD | INITIATE
  decidedAt      DateTime @default(now())
  decision       String   // "accepted" | "declined" | "deferred"
  acceptedAmount Float?   // user-overridden dollar amount on accept (null = full recommendation)
  declinedReason String?  // free text on decline
  systemSnapshot Json     // snapshot at decision time: thesisHealth, trajectory, ratchetTranche, currentPct, dollarAmount
}

// Individual tax lots within a Position. Tracked separately for FIFO
// gain/loss and LT-vs-ST tax computation at sell time.
model Lot {
  id           Int       @id @default(autoincrement())
  positionId   Int
  position     Position  @relation(fields: [positionId], references: [id])
  shares       Float
  costBasis    Float     // cost basis per share
  acquiredDate DateTime
  source       String    @default("manual") // "manual" | "import" | "schwab"
  closedDate   DateTime? // set when lot is fully sold
  notes        String?
  createdAt    DateTime  @default(now())
}
